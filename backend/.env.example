# Copy to .env and fill in. Never commit .env.

# Twelve Data key (free Basic plan, ADR-004). Without it the server starts but syncs nothing.
TWELVEDATA_API_KEY=

# Provider credit budget shared by the history sync and the quote refresher. The free plan
# allows 8/min and 800/day; about 410/day are used (ADR-004), the rest is margin.
PROVIDER_CREDITS_PER_MINUTE=8
PROVIDER_CREDITS_PER_DAY=700

# Requests per minute per client IP before the API answers 429. Behind a reverse proxy, every
# client shares the proxy's address: limit at the proxy instead and set 0 here.
API_REQUESTS_PER_MINUTE=120

# First date of history (ADR-004).
DATA_FLOOR=2000-01-03

DB_PATH=data/market.db

# The content tree (content/packs/<island>/<version>/): the server publishes its versions without
# drafts (contentcheck -release). Defaults to ../content; the Docker image sets /app/content, where
# docs/deploy.md mounts it, so leave it unset there.
# CONTENT_DIR=../content
PORT=8080
