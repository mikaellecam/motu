# Copy to .env and fill in. Never commit .env.

# Twelve Data key (free Basic plan, ADR-004). Without it the server starts but syncs nothing.
TWELVEDATA_API_KEY=

# Provider credit budget used by the sync jobs. The free plan allows 8/min and 800/day;
# the default daily share leaves room for quotes and manual calls.
PROVIDER_CREDITS_PER_MINUTE=8
PROVIDER_CREDITS_PER_DAY=400

# First date of history (ADR-004).
DATA_FLOOR=2000-01-03

DB_PATH=data/market.db
PORT=8080
