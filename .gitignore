# Provider API keys live only in the backend environment
backend/.env

# Local issue tracker, never committed
tracker/

# Issue worktrees
.worktrees/

# Backend database (local runs)
backend/data/

# Provider data, rebuilt by scripts/fetch-data.sh: never committed (ADR-007)
content/packs/*/*/datasets/
app/assets/packs/*.json
app/assets/logos/*
!app/assets/logos/.gitkeep

# Personal agent instructions (the tracker workflow), loaded after CLAUDE.md
CLAUDE.local.md
